# ════════════════════════════════════════════════════════
# Research Agentic AI — Environment Variables
# ════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file and rename it to .env
# 2. Replace the placeholder below with your actual Groq API key
# 3. NEVER commit the .env file to version control
# 4. The .env file is listed in .gitignore for your protection
#
# Get your free Groq API key at: https://console.groq.com
# ════════════════════════════════════════════════════════

# ── Required: Your Groq API Key ──────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Optional: Tavily Web Search API Key ──────────────────
# Enables real-time web search in Agent Chat
# Get your free key at: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ── Optional: Application Settings ───────────────────────
# Set to "true" to enable Flask debug mode (development only)
FLASK_DEBUG=false

# Port the application runs on (default: 5000)
PORT=5000
